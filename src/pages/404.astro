---
import BaseLayout from '~/layouts/BaseLayout.astro'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<BaseLayout title="404 — page introuvable" pageType="error">
  <div class="container-prose">
    <div class="error-page">
      <p class="error-code">404</p>
      <h1>Page introuvable</h1>
      <p>
        Cette page n'existe pas — ou peut-être qu'elle existait et a été archivée. Reviens à l'accueil pour explorer la veille.
      </p>
      <p>
        <a class="badge-soft" href={`${base}/`}>← Retour à l'accueil</a>
      </p>
    </div>
  </div>
</BaseLayout>
