---
import { getCollection } from 'astro:content'
import BaseLayout from '~/layouts/BaseLayout.astro'
import SourceList, { type SourceCardData } from '~/components/home/SourceList.tsx'

const sources = (await getCollection('sources')).sort(
  (a, b) => b.data.digested.valueOf() - a.data.digested.valueOf()
)

const totalConcepts = (await getCollection('concepts')).length

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const cardData: SourceCardData[] = sources.map((s) => ({
  id: s.id,
  title: s.data.title,
  excerpt: s.data.excerpt ?? '',
  digested: s.data.digested.toISOString(),
  format: s.data.format,
  level: s.data.level,
  topics: s.data.topics,
  url: `${base}/sources/${s.id}`,
}))
---

<BaseLayout
  title="Veille"
  description="Veille tech personnelle d'Amine — articles, vidéos et talks digérés en notes liées par topic (Rust, Frontend, Backend, IA, Architecture, et plus)."
  pageType="home"
>
  <div class="container-prose">
    <section class="hero">
      <div class="hero-meta">{sources.length} sources · {totalConcepts} concepts</div>
      <h1>Veille tech</h1>
      <p class="hero-tagline">
        Mes notes de lecture sur ce que j'apprends — articles, vidéos, talks digérés en concepts atomiques liés.
      </p>
    </section>
  </div>

  <div class="container">
    <SourceList client:load sources={cardData} baseUrl={base} />
  </div>
</BaseLayout>
