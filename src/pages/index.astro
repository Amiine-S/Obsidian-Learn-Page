---
import { getCollection } from 'astro:content'
import BaseLayout from '~/layouts/BaseLayout.astro'
import SourceList, { type FeedItem } from '~/components/home/SourceList.tsx'

const sources = await getCollection('sources')
const concepts = await getCollection('concepts')
const totalConcepts = concepts.length

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const sourceItems: FeedItem[] = sources.map((s) => ({
  kind: 'source',
  id: s.id,
  title: s.data.title,
  excerpt: s.data.excerpt ?? '',
  date: s.data.digested.toISOString(),
  format: s.data.format,
  topics: s.data.topics,
  url: `${base}/sources/${s.id}`,
}))

const conceptItems: FeedItem[] = concepts.map((c) => ({
  kind: 'concept',
  id: c.id,
  title: c.data.title.replace(/^Concept - /, ''),
  excerpt: c.data.oneLiner ?? c.data.excerpt ?? '',
  date: (c.data.created ?? new Date(0)).toISOString(),
  topics: c.data.topics,
  url: `${base}/concepts/${c.id}`,
}))

// Feed mixte trié par date desc — les sources prioritaires en cas d'égalité
const items = [...sourceItems, ...conceptItems].sort((a, b) => {
  const cmp = new Date(b.date).valueOf() - new Date(a.date).valueOf()
  if (cmp !== 0) return cmp
  if (a.kind === 'source' && b.kind === 'concept') return -1
  if (b.kind === 'source' && a.kind === 'concept') return 1
  return 0
})
---

<BaseLayout
  title="Veille"
  description="Veille tech personnelle d'Amine — articles, vidéos et talks digérés en notes liées par topic (Frontend, Backend, TypeScript, Rust, Effect-TS, Architecture, etc.)."
  pageType="home"
>
  <div class="container-prose">
    <section class="hero">
      <div class="hero-meta">{sources.length} sources · {totalConcepts} concepts</div>
      <h1>Veille tech</h1>
      <p class="hero-tagline">
        Mes notes de lecture sur ce que j'apprends — articles, vidéos, talks digérés en concepts atomiques liés.
      </p>
    </section>
  </div>

  <div class="container">
    <SourceList client:load items={items} baseUrl={base} />
  </div>
</BaseLayout>
